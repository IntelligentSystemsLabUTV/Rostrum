#!/usr/bin/env python3
"""Publish frames from a video file as ROS 2 Image messages."""

import time

import cv2
import rclpy
from rclpy.node import Node
from rclpy.qos import DurabilityPolicy, HistoryPolicy, QoSProfile, ReliabilityPolicy
from sensor_msgs.msg import Image


class VideoImagePublisher(Node):
    def __init__(self):
        super().__init__("video_image_publisher")

        self.declare_parameter("video_path", "")
        self.declare_parameter("topic_name", "/camera/image_rect_color")
        self.declare_parameter("frame_id", "camera")
        self.declare_parameter("fps", 0.0)
        self.declare_parameter("loop", False)
        self.declare_parameter("start_frame", 0)
        self.declare_parameter("max_frames", 0)
        self.declare_parameter("qos_depth", 10)
        self.declare_parameter("qos_reliability", "reliable")
        self.declare_parameter("wait_for_subscribers", True)
        self.declare_parameter("wait_timeout_sec", 10.0)

        self.video_path = self.get_parameter("video_path").value
        self.topic_name = self.get_parameter("topic_name").value
        self.frame_id = self.get_parameter("frame_id").value
        self.loop = bool(self.get_parameter("loop").value)
        self.start_frame = int(self.get_parameter("start_frame").value)
        self.max_frames = int(self.get_parameter("max_frames").value)
        self.wait_for_subscribers = bool(self.get_parameter("wait_for_subscribers").value)
        self.wait_timeout_sec = float(self.get_parameter("wait_timeout_sec").value)

        if not self.video_path:
            raise RuntimeError("Parameter 'video_path' is required")

        self.cap = cv2.VideoCapture(self.video_path)
        if not self.cap.isOpened():
            raise RuntimeError(f"Could not open video: {self.video_path}")

        if self.start_frame > 0:
            self.cap.set(cv2.CAP_PROP_POS_FRAMES, self.start_frame)

        video_fps = float(self.cap.get(cv2.CAP_PROP_FPS) or 0.0)
        requested_fps = float(self.get_parameter("fps").value)
        self.publish_fps = requested_fps if requested_fps > 0.0 else video_fps
        if self.publish_fps <= 0.0:
            self.publish_fps = 25.0

        self.publisher = self.create_publisher(Image, self.topic_name, self.make_qos_profile())
        if self.wait_for_subscribers:
            self.wait_until_matched()

        self.frame_count = 0
        self.timer = self.create_timer(1.0 / self.publish_fps, self.publish_next_frame)

        total_frames = int(self.cap.get(cv2.CAP_PROP_FRAME_COUNT))
        width = int(self.cap.get(cv2.CAP_PROP_FRAME_WIDTH))
        height = int(self.cap.get(cv2.CAP_PROP_FRAME_HEIGHT))
        self.get_logger().info(
            f"Publishing '{self.video_path}' on '{self.topic_name}' "
            f"at {self.publish_fps:.3f} FPS ({total_frames} frames, {width}x{height})"
        )

    def make_qos_profile(self):
        qos_depth = int(self.get_parameter("qos_depth").value)
        qos_reliability = str(self.get_parameter("qos_reliability").value).lower()
        if qos_depth < 1:
            raise RuntimeError("Parameter 'qos_depth' must be greater than zero")
        if qos_reliability in ("reliable", "reliability_reliable"):
            reliability = ReliabilityPolicy.RELIABLE
        elif qos_reliability in ("best_effort", "besteffort", "best-effort"):
            reliability = ReliabilityPolicy.BEST_EFFORT
        else:
            raise RuntimeError(
                "Parameter 'qos_reliability' must be 'reliable' or 'best_effort'"
            )
        return QoSProfile(
            depth=qos_depth,
            history=HistoryPolicy.KEEP_LAST,
            reliability=reliability,
            durability=DurabilityPolicy.VOLATILE,
        )

    def wait_until_matched(self):
        deadline = time.monotonic() + max(0.0, self.wait_timeout_sec)
        self.get_logger().info(
            f"Waiting for a subscriber on '{self.topic_name}' "
            f"for up to {self.wait_timeout_sec:.1f} s"
        )
        while rclpy.ok() and self.publisher.get_subscription_count() == 0:
            if time.monotonic() >= deadline:
                self.get_logger().warn(
                    f"No subscribers matched on '{self.topic_name}', starting video replay anyway"
                )
                return
            time.sleep(0.1)
        if self.publisher.get_subscription_count() > 0:
            self.get_logger().info(f"Matched subscriber on '{self.topic_name}'")

    def stop(self, reason):
        self.get_logger().info(reason)
        self.timer.cancel()
        if rclpy.ok():
            rclpy.shutdown()

    def publish_next_frame(self):
        if self.max_frames > 0 and self.frame_count >= self.max_frames:
            self.stop("Reached max_frames, stopping publisher")
            return

        ok, frame = self.cap.read()
        if not ok:
            if self.loop:
                self.cap.set(cv2.CAP_PROP_POS_FRAMES, self.start_frame)
                ok, frame = self.cap.read()
            if not ok:
                self.stop("Reached end of video, stopping publisher")
                return

        msg = Image()
        msg.header.stamp = self.get_clock().now().to_msg()
        msg.header.frame_id = self.frame_id
        msg.height = frame.shape[0]
        msg.width = frame.shape[1]
        msg.encoding = "bgr8"
        msg.is_bigendian = False
        msg.step = frame.shape[1] * frame.shape[2]
        msg.data = frame.tobytes()

        self.publisher.publish(msg)
        self.frame_count += 1

    def destroy_node(self):
        if hasattr(self, "cap"):
            self.cap.release()
        super().destroy_node()


def main():
    rclpy.init()
    node = None
    try:
        node = VideoImagePublisher()
        rclpy.spin(node)
    finally:
        if node is not None:
            node.destroy_node()
        if rclpy.ok():
            rclpy.shutdown()


if __name__ == "__main__":
    main()
